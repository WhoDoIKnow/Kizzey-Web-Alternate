{
  "name": "Kizzey",
  "short_name": "Kizzey",
  "description": "Discord Rich Presence, chat, weather and health — served by your own Kizzey server.",
  "id": "/",
  "start_url": "/#/home",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait",
  "background_color": "#141118",
  "theme_color": "#141118",
  "categories": ["social", "utilities"],
  "icons": [
    {
      "src": "/icon.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-fg-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Home",
      "short_name": "Home",
      "url": "/#/home",
      "icons": [{ "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" }]
    },
    {
      "name": "Custom RPC",
      "short_name": "Custom RPC",
      "url": "/#/custom",
      "icons": [{ "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" }]
    },
    {
      "name": "Kizzey Chat",
      "short_name": "Chat",
      "url": "/#/chat",
      "icons": [{ "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" }]
    }
  ]
}
