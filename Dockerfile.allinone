# Kizzey Web — single-container build with the Discord voice service.
#
# This image runs both processes in one container, which is useful on hosts
# that only allow one service. For a normal deployment use docker-compose.yml.
#
#   docker build -f Dockerfile.allinone -t kizzey-voice .
#   docker run -p 8420:8420 -v kizzey-data:/app/data kizzey-voice
#
# Both processes sit on loopback, so no shared secret is required. Voice joins
# with the Discord account token Kizzey already stores for RPC.
FROM node:22-slim

ENV NODE_ENV=production \
    KIZZEY_HOST=0.0.0.0 \
    KIZZEY_PORT=8420 \
    KIZZEY_VOICE_URL=http://127.0.0.1:8421 \
    VOICE_HOST=127.0.0.1 \
    VOICE_PORT=8421 \
    VOICE_RECORDINGS_DIR=/app/data/voice_recordings

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg yt-dlp ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json ./
COPY scripts ./scripts
RUN npm ci --no-audit --no-fund

COPY server.js script_pull.js ./
COPY lib ./lib
COPY static ./static
COPY voice_service/index.js ./voice_service/index.js

RUN mkdir -p /app/data/voice_recordings
VOLUME ["/app/data"]
EXPOSE 8420

HEALTHCHECK --interval=30s --timeout=5s --start-period=25s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:'+(process.env.KIZZEY_PORT||'8420')+'/api/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

# script_pull supervises both children and forwards SIGTERM.
CMD ["node", "script_pull.js", "--no-pull"]
